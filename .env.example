# Postgres (docker compose up -d db). Sqlite try karna ho: sqlite:///./clinic.db
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/clinic_db
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Pehla admin account (startup par ban jata hai). Chahiye na ho to khali chhor do
ADMIN_EMAIL=admin@clinic.com
ADMIN_PASSWORD=Admin12345
